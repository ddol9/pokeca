# 로컬 값은 `npx supabase status -o env`로 확인한다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# 어드민 로그인(브라우저)에만 쓴다. 이 키로는 어떤 테이블도 읽을 수 없다(RLS 기본 거부).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_SECRET_KEY=
# 테스트 전용(로컬 스택). 운영 값은 넣지 않는다.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# 정리 작업 호출 인증(Vercel Cron). 임의의 긴 문자열.
CRON_SECRET=
# 신고 남용 방지용 IP 대역 해시 비밀값. 임의의 긴 문자열.
REPORT_HASH_SECRET=
# 신고 알림 메일(Resend). 셋 중 하나라도 비면 메일 대신 서버 로그로만 남긴다.
RESEND_API_KEY=
# 받는 주소(쉼표로 여러 개)
REPORT_NOTIFY_TO=
# Resend에서 인증한 도메인의 주소. 예: 확장 아트 <alerts@example.com>
REPORT_NOTIFY_FROM=
